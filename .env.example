# Copy to .env at the repository root. Both keys are optional.

# Google AI Studio — Gemini narration only (tools/prepare_narration.py --mode ai).
# Recorded and silent projects do not need this key.
GEMINI_API_KEY=

# Conservative local free-tier guard for Gemini 3.1 Flash TTS Preview.
# Defaults leave one of the current 10 daily requests unused and wait 31 seconds
# between attempts (including retries). Only change these when AI Studio shows
# different limits. Set USED_TODAY for requests made outside this repository.
GEMINI_TTS_RPD_LIMIT=10
GEMINI_TTS_DAILY_RESERVE=1
GEMINI_TTS_MIN_INTERVAL_SECONDS=31
GEMINI_TTS_USED_TODAY=0

# fal.ai — true generative-video clips only (tools/gen_clip.py).
FAL_KEY=
